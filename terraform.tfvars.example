# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values
# Note: terraform.tfvars is gitignored for security

# AWS Configuration
aws_region = "us-east-1"

# Cluster Configuration
cluster_name = "wikijs-cluster"
environment  = "production"

# Database Configuration (REQUIRED)
db_password = "CHANGE_ME_TO_SECURE_PASSWORD"

# Admin Configuration (REQUIRED)
wikijs_admin_email = "admin@example.com"

# Aurora Serverless v2 Configuration (Optional - defaults are cost-optimized)
# aurora_min_capacity = 0.5  # Minimum capacity units (0.5 = 1GB RAM)
# aurora_max_capacity = 1.0  # Maximum capacity units (1.0 = 2GB RAM)
